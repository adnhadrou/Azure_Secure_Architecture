{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "adminSource": {
      "type": "string"
    },
    "sshPublicKey": {
      "type": "string"
    },
    "shutdownTime": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Choose a permitted region with sufficient subscription quota."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-11-01",
      "name": "nsg-pfa-servers",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "admin-ssh-https",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[parameters('adminSource')]",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRanges": [
                "22",
                "443"
              ]
            }
          },
          {
            "name": "certificate-http",
            "properties": {
              "priority": 110,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "80"
            }
          },
          {
            "name": "package-updates",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationPortRanges": [
                "80",
                "443"
              ]
            }
          },
          {
            "name": "azure-dns",
            "properties": {
              "priority": 110,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "168.63.129.16",
              "sourcePortRange": "*",
              "destinationPortRange": "53"
            }
          },
          {
            "name": "azure-agent",
            "properties": {
              "priority": 120,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "168.63.129.16",
              "sourcePortRange": "*",
              "destinationPortRanges": [
                "80",
                "32526"
              ]
            }
          },
          {
            "name": "time-sync",
            "properties": {
              "priority": 130,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Udp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationPortRange": "123"
            }
          },
          {
            "name": "deny-unlisted-inbound",
            "properties": {
              "priority": 4096,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*"
            }
          },
          {
            "name": "deny-unlisted-outbound",
            "properties": {
              "priority": 4096,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*"
            }
          },
          {
            "name": "wazuh-agent",
            "properties": {
              "priority": 140,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "10.0.5.10",
              "sourcePortRange": "*",
              "destinationPortRanges": [
                "1514",
                "1515"
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-11-01",
      "name": "pip-vm-pfa-services",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-11-01",
      "name": "nic-vm-pfa-services",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses','pip-vm-pfa-services')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups','nsg-pfa-servers')]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "10.0.3.10",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets','vnet-pfa','snet-servers')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses','pip-vm-pfa-services')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "vm-pfa-services",
      "location": "[parameters('location')]",
      "tags": {
        "project": "PFA",
        "purpose": "temporary-demo",
        "role": "services"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces','nic-vm-pfa-services')]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2as_v2"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "name": "osdisk-vm-pfa-services",
            "createOption": "FromImage",
            "diskSizeGB": 64,
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "deleteOption": "Delete"
          }
        },
        "osProfile": {
          "computerName": "vm-pfa-services",
          "adminUsername": "labadmin",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/labadmin/.ssh/authorized_keys",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces','nic-vm-pfa-services')]",
              "properties": {
                "deleteOption": "Delete"
              }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.DevTestLab/schedules",
      "apiVersion": "2018-09-15",
      "name": "shutdown-computevm-vm-pfa-services",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines','vm-pfa-services')]"
      ],
      "properties": {
        "status": "Enabled",
        "taskType": "ComputeVmShutdownTask",
        "dailyRecurrence": {
          "time": "[parameters('shutdownTime')]"
        },
        "timeZoneId": "UTC",
        "notificationSettings": {
          "status": "Disabled",
          "timeInMinutes": 30
        },
        "targetResourceId": "[resourceId('Microsoft.Compute/virtualMachines','vm-pfa-services')]"
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-11-01",
      "name": "nsg-pfa-monitor",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "admin-ssh-https",
            "properties": {
